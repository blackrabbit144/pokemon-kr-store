{{ 'section-footer.css' | asset_url | stylesheet_tag }}
{{ 'component-list-payment.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .footer {
    margin-top: {{ section.settings.margin_top | times: 0.75 | round: 0 }}px;
  }
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }
  @media screen and (min-width: 750px) {
    .footer {
      margin-top: {{ section.settings.margin_top }}px;
    }
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
  .footer-custom {
    background-color: #ffffff;
    border-top: 1px solid rgba(0,0,0,0.08);
  }
  .footer-custom__top {
    display: grid;
    grid-template-columns: 1.6fr 1fr 1fr;
    gap: 40px;
    padding: 48px 0 32px;
  }
  .footer-custom__logo {
    font-size: 18px;
    font-weight: 700;
    color: #E60012;
    margin-bottom: 10px;
    text-decoration: none;
    display: inline-block;
  }
  .footer-custom__desc {
    font-size: 13px;
    color: #666;
    line-height: 1.7;
    margin-bottom: 16px;
  }
  .footer-custom__sns {
    display: flex;
    gap: 8px;
  }
  .footer-custom__sns-link {
    display: flex;
    align-items: center;
    gap: 5px;
    padding: 5px 12px;
    border: 0.5px solid #ddd;
    border-radius: 6px;
    font-size: 12px;
    color: #444;
    text-decoration: none;
  }
  .footer-custom__sns-link:hover {
    border-color: #E60012;
    color: #E60012;
  }
  .footer-custom__col-title {
    font-size: 13px;
    font-weight: 700;
    color: #111;
    margin-bottom: 12px;
  }
  .footer-custom__links {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .footer-custom__links li {
    margin-bottom: 8px;
  }
  .footer-custom__links a {
    font-size: 13px;
    color: #666;
    text-decoration: none;
  }
  .footer-custom__links a:hover {
    color: #E60012;
  }
  .footer-custom__bottom {
    border-top: 0.5px solid rgba(0,0,0,0.08);
    padding: 16px 0;
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 12px;
  }
  .footer-custom__copyright {
    font-size: 11px;
    color: #999;
  }
  .footer-custom__payment {
    display: flex;
    gap: 6px;
    align-items: center;
  }
  .footer-custom__policies {
    display: flex;
    gap: 14px;
  }
  .footer-custom__policies a {
    font-size: 11px;
    color: #999;
    text-decoration: none;
  }
  .footer-custom__policies a:hover {
    color: #E60012;
  }
  @media screen and (max-width: 749px) {
    .footer-custom__top {
      grid-template-columns: 1fr;
      gap: 24px;
      padding: 32px 0 24px;
    }
    .footer-custom__bottom {
      flex-direction: column;
      align-items: flex-start;
    }
  }
{%- endstyle -%}

<footer class="footer-custom footer color-{{ section.settings.color_scheme }} section-{{ section.id }}-padding">
  <div class="page-width">

    <div class="footer-custom__top">

      <!-- Col 1: Logo + Description + SNS -->
      <div>
        <a href="{{ routes.root_url }}" class="footer-custom__logo">{{ shop.name }}</a>
        <p class="footer-custom__desc">Your #1 source for authentic Korean Pokémon cards — shipped worldwide. Sealed packs and boxes only. No singles.</p>
        <div class="footer-custom__sns">
          {%- if settings.social_twitter_link != blank -%}
            <a href="{{ settings.social_twitter_link }}" target="_blank" class="footer-custom__sns-link" aria-label="Twitter">
              <svg width="13" height="13" viewBox="0 0 24 24" fill="currentColor"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-4.714-6.231-5.401 6.231H2.746l7.73-8.835L1.254 2.25H8.08l4.253 5.622zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
              Twitter
            </a>
          {%- endif -%}
          {%- if settings.social_instagram_link != blank -%}
            <a href="{{ settings.social_instagram_link }}" target="_blank" class="footer-custom__sns-link" aria-label="Instagram">
              <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="2" width="20" height="20" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="0.5" fill="currentColor"/></svg>
              Instagram
            </a>
          {%- endif -%}
        </div>
      </div>

      <!-- Col 2: Shop links -->
      <div>
        <div class="footer-custom__col-title">Shop</div>
        <ul class="footer-custom__links">
          <li><a href="/collections/all">Sealed Products</a></li>
          <li><a href="/collections/booster-boxes">Booster Boxes</a></li>
          <li><a href="/collections/collections">Collections</a></li>
          <li><a href="/collections/pre-order">Pre-Order</a></li>
          <li><a href="/collections/accessories">Accessories</a></li>
          <li><a href="/pages/promotions">Promotions</a></li>
        </ul>
      </div>

      <!-- Col 3: Support links -->
      <div>
        <div class="footer-custom__col-title">Support</div>
        <ul class="footer-custom__links">
          <li><a href="{{ shop.url }}/policies/shipping-policy">Shipping Policy</a></li>
          <li><a href="{{ shop.url }}/policies/refund-policy">Returns & Refunds</a></li>
          <li><a href="/pages/faq">FAQ</a></li>
          <li><a href="/pages/contact">Contact Us</a></li>
        </ul>
      </div>

    </div>

    <!-- Bottom bar -->
    <div class="footer-custom__bottom">
      <div class="footer-custom__copyright">
        &copy; {{ 'now' | date: '%Y' }} {{ shop.name }}. Powered by Shopify.
      </div>
      <div class="footer-custom__payment">
        {%- for type in shop.enabled_payment_types -%}
          {{ type | payment_type_svg_tag: class: 'icon icon--full-color' }}
        {%- endfor -%}
      </div>
      <div class="footer-custom__policies">
        <a href="{{ shop.url }}/policies/privacy-policy">Privacy Policy</a>
        <a href="{{ shop.url }}/policies/terms-of-service">Terms of Service</a>
        <a href="{{ shop.url }}/policies/refund-policy">Refund Policy</a>
        <a href="{{ shop.url }}/policies/shipping-policy">Shipping Policy</a>
      </div>
    </div>

  </div>
</footer>

{% schema %}
{
  "name": "t:sections.footer.name",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    },
    {
      "type": "checkbox",
      "id": "payment_enable",
      "default": true,
      "label": "t:sections.footer.settings.payment_enable.label"
    },
    {
      "type": "header",
      "content": "t:sections.all.spacing"
    },
    {
      "type": "range",
      "id": "margin_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.footer.settings.margin_top.label",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 36
    }
  ],
  "blocks": [],

}
{% endschema %}