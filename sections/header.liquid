<link rel="stylesheet" href="{{ 'component-list-menu.css' | asset_url }}" media="print" onload="this.media='all'">
<link rel="stylesheet" href="{{ 'component-search.css' | asset_url }}" media="print" onload="this.media='all'">
<link rel="stylesheet" href="{{ 'component-menu-drawer.css' | asset_url }}" media="print" onload="this.media='all'">
<link rel="stylesheet" href="{{ 'component-cart-notification.css' | asset_url }}" media="print" onload="this.media='all'">

{%- if settings.predictive_search_enabled -%}
  <link rel="stylesheet" href="{{ 'component-price.css' | asset_url }}" media="print" onload="this.media='all'">
{%- endif -%}

<script src="{{ 'cart-notification.js' | asset_url }}" defer="defer"></script>

<style>
  .header-custom {
    position: sticky;
    top: 0;
    z-index: 100;
    width: 100%;
    background: #ffffff;
  }

  /* 上層 */
  .header-custom__top {
    display: flex;
    align-items: center;
    padding: 10px 40px;
    background: #E60012;
    border-bottom: 0.5px solid rgba(255,255,255,0.3);
    position: relative;
  }

  .header-custom__right {
    justify-self: end;
  }

  .header-custom__logo {
    display: flex;
    justify-content: center;
    align-items: center;
  }

  @media screen and (max-width: 749px) {
    .header-custom__top {
      justify-content: space-between;
    }
    .header-custom__logo {
      position: static !important;
      transform: none !important;
    }
    .header-custom__search-form {
      width: 100px;
    }
  }

  .header-custom__logo a {
    font-size: 20px;
    font-weight: 700;
    color: #ffffff;
    text-decoration: none;
    letter-spacing: -0.02em;
  }

  .header-custom__logo-sub {
    font-size: 10px;
    color: #999;
    display: block;
    text-align: center;
  }

  .header-custom__right {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-left: auto;
  }

  /* 小さい検索バー */
  .header-custom__search-form {
    display: flex;
    align-items: center;
    border-radius: 20px;
    padding: 4px 12px;
    gap: 6px;
    background: rgba(255,255,255,0.2);
    border: 1px solid rgba(255,255,255,0.4);
    cursor: pointer;
    width: 160px;
  }

  .header-custom__search-form input {
    border: none;
    background: transparent;
    font-size: 12px;
    color: #ffffff;
    outline: none;
    width: 100%;
  }

  .header-custom__search-form svg {
    width: 13px;
    height: 13px;
    stroke: #ffffff;
    fill: none;
    stroke-width: 1.5;
    stroke-linecap: round;
    stroke-linejoin: round;
    flex-shrink: 0;
  }

  .header-custom__icon-btn {
    width: 34px;
    height: 34px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 8px;
    text-decoration: none;
    color: #ffffff;
    position: relative;
  }

  .header-custom__icon-btn:hover { background: #f0f0f0; }

  .header-custom__icon-btn svg {
    width: 18px;
    height: 18px;
    stroke: #ffffff;
    fill: none;
    stroke-width: 1.5;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .header-custom__cart-count {
    position: absolute;
    top: 2px;
    right: 2px;
    background: #E60012;
    color: #fff;
    font-size: 9px;
    font-weight: 700;
    width: 16px;
    height: 16px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  /* 区切り線 */
  .header-custom__divider {
    height: 0.5px;
    background: rgba(230, 0, 18, 0.2);
    width: 100%;
  }

  /* 下層 */
  .header-custom__bottom {
    background: #E60012;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 14px 40px;
  }

  .header-custom__nav {
    display: flex;
    align-items: center;
    gap: 40px;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .header-custom__nav > li {
    position: relative;
  }

  .header-custom__nav > li > a,
  .header-custom__nav > li > details > summary {
    font-size: 14px;
    font-weight: 700;
    color: #ffffff;
    text-decoration: none;
    cursor: pointer;
    list-style: none;
    display: flex;
    align-items: center;
    gap: 4px;
    padding: 2px 0;
    border-bottom: 2px solid transparent;
    transition: border-color 0.15s ease;
  }

  .header-custom__nav > li > a:hover,
  .header-custom__nav > li > details > summary:hover {
    border-bottom-color: rgba(255,255,255,0.6);
  }

  .header-custom__nav > li > details > summary::-webkit-details-marker { display: none; }
  .header-custom__nav > li > details > summary { list-style: none; }

  .header-custom__nav .caret {
    font-size: 9px;
    opacity: 0.7;
  }

  /* ドロップダウン */
  .header-custom__dropdown {
    position: absolute;
    top: calc(100% + 14px);
    left: 50%;
    transform: translateX(-50%);
    background: #ffffff;
    border-radius: 8px;
    box-shadow: 0 8px 24px rgba(0,0,0,0.12);
    min-width: 180px;
    padding: 8px 0;
    list-style: none;
    margin: 0;
    z-index: 200;
  }

  .header-custom__dropdown li a {
    display: block;
    padding: 8px 20px;
    font-size: 13px;
    font-weight: 500;
    color: #333;
    text-decoration: none;
    transition: background 0.1s;
  }

  .header-custom__dropdown li a:hover {
    background: #fff0f0;
    color: #E60012;
  }

  details:not([open]) .header-custom__dropdown { display: none; }
  details[open] .header-custom__dropdown { display: block; }

  /* 検索モーダル */
  .header-custom__search-modal {
    display: none;
    position: fixed;
    inset: 0;
    background: rgba(0,0,0,0.4);
    z-index: 9999;
    align-items: flex-start;
    justify-content: center;
    padding-top: 100px;
  }
  .header-custom__search-modal.open {
    display: flex;
  }
  .header-custom__search-box {
    background: #fff;
    border-radius: 12px;
    padding: 20px;
    width: 90%;
    max-width: 560px;
    display: flex;
    align-items: center;
    gap: 10px;
    box-shadow: 0 8px 32px rgba(0,0,0,0.15);
  }
  .header-custom__search-box input {
    flex: 1;
    border: none;
    outline: none;
    font-size: 16px;
    color: #333;
  }
  .header-custom__search-box svg {
    width: 18px;
    height: 18px;
    stroke: #888;
    fill: none;
    stroke-width: 1.5;
    stroke-linecap: round;
    stroke-linejoin: round;
    flex-shrink: 0;
  }
  .header-custom__search-close {
    font-size: 20px;
    color: #888;
    cursor: pointer;
    background: none;
    border: none;
    padding: 0 4px;
  }
</style>

{% liquid
  assign header_tag = 'div'
  if section.settings.sticky_header_type != 'none'
    assign header_tag = 'sticky-header'
  endif
%}

<{{ header_tag }}
  {% if header_tag == 'sticky-header' %}
    data-sticky-type="{{ section.settings.sticky_header_type }}"
  {% endif %}
  class="header-wrapper color-{{ section.settings.color_scheme }} gradient{% if section.settings.show_line_separator %} header-wrapper--border-bottom{% endif %}"
>

<div class="header-custom">

  <!-- 上層 -->
  <div class="header-custom__top">

    <!-- 中央：ロゴ -->
    <div class="header-custom__logo" style="position:absolute; left:50%; transform:translateX(-50%); display:flex; justify-content:center; align-items:center;">

      {%- if request.page_type == 'index' -%}<h1 style="margin:0;">{%- endif -%}
      <a href="{{ routes.root_url }}">
        {%- if settings.logo != blank -%}
          {%- assign logo_alt = settings.logo.alt | default: shop.name | escape -%}
          {%- assign logo_height = settings.logo_width | divided_by: settings.logo.aspect_ratio -%}
          {{
            settings.logo
            | image_url: width: 600
            | image_tag:
              class: 'header__heading-logo',
              width: settings.logo_width,
              height: logo_height,
              alt: logo_alt
          }}
        {%- else -%}
          {{ shop.name }}
        {%- endif -%}
      </a>
      {%- if request.page_type == 'index' -%}</h1>{%- endif -%}
    </div>

    <!-- 右：検索バー＋アイコン -->
    <div class="header-custom__right">
      <!-- 小さい検索バー（クリックでモーダル） -->
      <div class="header-custom__search-form" onclick="document.getElementById('searchModal').classList.add('open')">
        <svg viewBox="0 0 24 24"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/></svg>
        <input type="text" placeholder="Search..." readonly>
      </div>

      <!-- マイページ -->
      <a
        href="{%- if customer -%}{{ routes.account_url }}{%- else -%}{{ routes.account_login_url }}{%- endif -%}"
        class="header-custom__icon-btn"
        aria-label="My page"
      >
        <svg viewBox="0 0 24 24"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
      </a>

      <!-- カート -->
      <a href="{{ routes.cart_url }}" class="header-custom__icon-btn" aria-label="Cart" id="cart-icon-bubble">
        <svg viewBox="0 0 24 24"><path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"/><line x1="3" y1="6" x2="21" y2="6"/><path d="M16 10a4 4 0 0 1-8 0"/></svg>
        {%- if cart.item_count > 0 -%}
          <span class="header-custom__cart-count">{{ cart.item_count }}</span>
        {%- endif -%}
      </a>
    </div>
  </div>

  <!-- 区切り線 -->
  <div class="header-custom__divider"></div>

  <!-- 下層：ナビゲーション -->
  <div class="header-custom__bottom">
    <ul class="header-custom__nav">
      {%- for link in section.settings.menu.links -%}
        {%- if link.links != blank -%}
          <li>
            <details>
              <summary>
                {{ link.title | escape }}
                <span class="caret">▾</span>
              </summary>
              <ul class="header-custom__dropdown">
                {%- for childlink in link.links -%}
                  <li>
                    <a href="{{ childlink.url }}">{{ childlink.title | escape }}</a>
                  </li>
                {%- endfor -%}
                {%- if link.handle == 'sealed' -%}
                  <li><a href="/collections/all">All Products</a></li>
                {%- endif -%}
              </ul>
            </details>
          </li>
        {%- else -%}
          <li>
            <a href="{{ link.url }}"{% if link.current %} aria-current="page"{% endif %}>
              {{ link.title | escape }}
            </a>
          </li>
        {%- endif -%}
      {%- endfor -%}
    </ul>
  </div>

</div>

</{{ header_tag }}>

<!-- 検索モーダル -->
<div id="searchModal" class="header-custom__search-modal" onclick="if(event.target===this)this.classList.remove('open')">
  <div class="header-custom__search-box">
    <svg viewBox="0 0 24 24"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/></svg>
    <form action="{{ routes.search_url }}" method="get" style="flex:1; display:flex;">
      <input type="text" name="q" placeholder="Search Korean Pokémon cards..." autofocus style="flex:1; border:none; outline:none; font-size:16px;">
    </form>
    <button class="header-custom__search-close" onclick="document.getElementById('searchModal').classList.remove('open')">✕</button>
  </div>
</div>

{%- if settings.cart_type == 'notification' -%}
  {%- render 'cart-notification',
    color_scheme: section.settings.color_scheme,
    desktop_menu_type: section.settings.menu_type_desktop
  -%}
{%- endif -%}

{% javascript %}
  class StickyHeader extends HTMLElement {
    constructor() { super(); }
    connectedCallback() {
      this.header = document.querySelector('.section-header');
      this.headerIsAlwaysSticky = this.getAttribute('data-sticky-type') === 'always' || this.getAttribute('data-sticky-type') === 'reduce-logo-size';
      this.headerBounds = {};
      this.setHeaderHeight();
      window.matchMedia('(max-width: 990px)').addEventListener('change', this.setHeaderHeight.bind(this));
      if (this.headerIsAlwaysSticky) { this.header.classList.add('shopify-section-header-sticky'); }
      this.currentScrollTop = 0;
      this.preventReveal = false;
      this.predictiveSearch = this.querySelector('predictive-search');
      this.onScrollHandler = this.onScroll.bind(this);
      this.hideHeaderOnScrollUp = () => (this.preventReveal = true);
      this.addEventListener('preventHeaderReveal', this.hideHeaderOnScrollUp);
      window.addEventListener('scroll', this.onScrollHandler, false);
      this.createObserver();
    }
    setHeaderHeight() {
      document.documentElement.style.setProperty('--header-height', `${this.header.offsetHeight}px`);
    }
    disconnectedCallback() {
      this.removeEventListener('preventHeaderReveal', this.hideHeaderOnScrollUp);
      window.removeEventListener('scroll', this.onScrollHandler);
    }
    createObserver() {
      let observer = new IntersectionObserver((entries, observer) => {
        this.headerBounds = entries[0].intersectionRect;
        observer.disconnect();
      });
      observer.observe(this.header);
    }
    onScroll() {
      const scrollTop = window.pageYOffset || document.documentElement.scrollTop;
      if (this.predictiveSearch && this.predictiveSearch.isOpen) return;
      if (scrollTop > this.currentScrollTop && scrollTop > this.headerBounds.bottom) {
        this.header.classList.add('scrolled-past-header');
        if (this.preventHide) return;
        requestAnimationFrame(this.hide.bind(this));
      } else if (scrollTop < this.currentScrollTop && scrollTop > this.headerBounds.bottom) {
        this.header.classList.add('scrolled-past-header');
        if (!this.preventReveal) {
          requestAnimationFrame(this.reveal.bind(this));
        } else {
          window.clearTimeout(this.isScrolling);
          this.isScrolling = setTimeout(() => { this.preventReveal = false; }, 66);
          requestAnimationFrame(this.hide.bind(this));
        }
      } else if (scrollTop <= this.headerBounds.top) {
        this.header.classList.remove('scrolled-past-header');
        requestAnimationFrame(this.reset.bind(this));
      }
      this.currentScrollTop = scrollTop;
    }
    hide() {
      if (this.headerIsAlwaysSticky) return;
      this.header.classList.add('shopify-section-header-hidden', 'shopify-section-header-sticky');
    }
    reveal() {
      if (this.headerIsAlwaysSticky) return;
      this.header.classList.add('shopify-section-header-sticky', 'animate');
      this.header.classList.remove('shopify-section-header-hidden');
    }
    reset() {
      if (this.headerIsAlwaysSticky) return;
      this.header.classList.remove('shopify-section-header-hidden', 'shopify-section-header-sticky', 'animate');
    }
  }
  document.addEventListener('click', function(e) {
    document.querySelectorAll('.header-custom__nav details[open]').forEach(function(detail) {
      if (!detail.contains(e.target)) {
        detail.removeAttribute('open');
      }
    });
  });
  customElements.define('sticky-header', StickyHeader);
{% endjavascript %}

{% schema %}
{
  "name": "t:sections.header.name",
  "class": "section-header",
  "max_blocks": 3,
  "settings": [
    {
      "type": "link_list",
      "id": "menu",
      "default": "main-menu",
      "label": "t:sections.header.settings.menu.label"
    },
    {
      "type": "select",
      "id": "menu_type_desktop",
      "options": [
        { "value": "dropdown", "label": "t:sections.header.settings.menu_type_desktop.options__1.label" },
        { "value": "mega", "label": "t:sections.header.settings.menu_type_desktop.options__2.label" },
        { "value": "drawer", "label": "t:sections.header.settings.menu_type_desktop.options__3.label" }
      ],
      "default": "dropdown",
      "label": "t:sections.header.settings.menu_type_desktop.label"
    },
    {
      "type": "select",
      "id": "sticky_header_type",
      "options": [
        { "value": "none", "label": "t:sections.header.settings.sticky_header_type.options__1.label" },
        { "value": "on-scroll-up", "label": "t:sections.header.settings.sticky_header_type.options__2.label" },
        { "value": "always", "label": "t:sections.header.settings.sticky_header_type.options__3.label" },
        { "value": "reduce-logo-size", "label": "t:sections.header.settings.sticky_header_type.options__4.label" }
      ],
      "default": "on-scroll-up",
      "label": "t:sections.header.settings.sticky_header_type.label"
    },
    {
      "type": "checkbox",
      "id": "show_line_separator",
      "default": true,
      "label": "t:sections.header.settings.show_line_separator.label"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    },
    {
      "type": "color_scheme",
      "id": "menu_color_scheme",
      "label": "t:sections.header.settings.menu_color_scheme.label",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "margin_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.header.settings.margin_bottom.label",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 36,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 20
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 36,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 20
    }
  ],
  "blocks": [
    { "type": "@app" }
  ]
}
{% endschema %}